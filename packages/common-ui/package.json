{
  "name": "repo-depkit-common-ui",
  "version": "1.0.0",
  "main": "index.ts",
  "license": "MIT",
  "private": true,
  "peerDependencies": {
    "@expo/vector-icons": "*",
    "@gorhom/bottom-sheet": "^5.2.9",
    "expo-asset": "*",
    "expo-clipboard": "*",
    "expo-document-picker": "*",
    "expo-file-system": "*",
    "expo-location": "*",
    "expo-sqlite": "*",
    "expo-updates": "*",
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": "*",
    "react-native-qrcode-svg": "*",
    "react-native-reanimated": "*",
    "react-native-render-html": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*",
    "react-native-webview": "*"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "buffer": "^6.0.3",
    "repo-depkit-common": "workspace:*",
    "tinycolor2": "^1.6.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/tinycolor2": "^1.4.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.3",
    "typescript": "*"
  },
  "scripts": {
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "jest-environment-node",
    "roots": [
      "<rootDir>/src"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.test.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^expo-sqlite$": "<rootDir>/src/__tests__/mocks/expo-sqlite.ts"
    },
    "testMatch": [
      "<rootDir>/src/**/*.test.ts?(x)"
    ]
  }
}
