{
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"strict": true,
		"types": ["node"],
		"outDir": "./dist",
		"rootDir": "."
	},
	"include": ["src/**/*.ts", "generate.ts"],
	"exclude": ["node_modules", "generated", "dist"]
}
